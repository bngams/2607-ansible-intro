global
    daemon

defaults
    mode http
    timeout connect 5s
    timeout client  30s
    timeout server  30s

# --- INGRESS : par ou le trafic entre ---
frontend http_in
    bind *:{{ haproxy_listen_port }}
    default_backend wordpress_app

# --- BACKEND : vers l'application ---
backend wordpress_app
    server wp1 {{ wp_backend_host }}:{{ wp_backend_port }} check
